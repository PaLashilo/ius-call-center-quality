@startuml
state "Оценка звонка" as E {
 [*] --> Импортирован
 Импортирован --> Рассчитан : P03–P05
 Рассчитан --> ПредложениеИИ : агент ответил валидно
 Рассчитан --> РучнаяОценка : агент недоступен / невалиден
 Рассчитан --> НаПроверке : «иное»
 ПредложениеИИ --> НаПроверке
 РучнаяОценка --> НаПроверке
 НаПроверке --> Утверждён : аудитор
 Утверждён --> [*]
}
state "Сценарий" as S {
 [*] --> Черновик : аналитик [предложение автора]
 Черновик --> НаСогласовании
 НаСогласовании --> Опубликован : аудитор [предложение автора]
 НаСогласовании --> Черновик : возврат
 Опубликован --> Архив : выпущена версия N+1
}
@enduml
