@startuml
actor Аудитор
participant "UI аудитора" as UI
participant "Ядро ИАС" as Core
participant "ИИ-агент" as AG
participant "Адаптеры ИС (только чтение)" as AD
database "Журнал" as LOG
Аудитор -> UI : открыть очередь звонков
UI -> Core : получить карточку
Core -> AD : тема помощника, события*, транскрипт*, P05
AD --> Core : данные
Core -> Core : P03, P04 по событиям; группа по теме
Core -> AG : сценарий группы + обезличенный транскрипт
AG --> Core : P01, P02, P06, темы, цитаты, уверенность
Core -> Core : валидация схемы/порога; иначе fallback
Core -> LOG : предложение агента
Core --> UI : карточка: числа + качество + объяснение
UI --> Аудитор : показать
Аудитор -> UI : утвердить / изменить + комментарий
UI -> Core : решение аудитора
Core -> LOG : решение, автор, время
Core --> UI : статус «утверждено»
@enduml
